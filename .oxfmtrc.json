{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": {
    "internalPattern": ["~test/"],
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/*.md",
    "/node_modules",
    "/.pnpm-store",
    "/config.js",
    "/coverage",
    "/dist",
    "/tmp",
    ".cache",
    "/*.log",
    "package.json",
    "**/__fixtures__/",
    "**/__mocks__/",
    ".clinic/",
    "**/*.generated.ts",
    "lib/modules/datasource/hex/v2/package.ts",
    "lib/modules/datasource/hex/v2/signed.ts",
    "/tools/dist",
    "/patches",
    "**/tmp/",
    "/.venv/",
    "uv.lock",
    "pnpm-lock.yaml",
    "pdm.lock",
    "/tools/mkdocs/mkdocs.yml",
    "/tools/mkdocs/overrides/main.html",
    "/tools/mkdocs/.cache",
    "/tools/mkdocs/docs",
    "/tools/mkdocs/site",
    "/.worktrees",
    "/.claude/worktrees",
    "/.claude/launch.json",
    "/.claude/loop.md",
    "/.claude/scheduled_tasks.json",
    "/.mcp.json"
  ]
}
