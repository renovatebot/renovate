#!/bin/bash

if [[ -f "/usr/local/etc/env" && -z "${CONTAINERBASE_ENV+x}" ]]; then
    # shellcheck source=/dev/null
  . /usr/local/etc/env
fi

if [[ ! -d "/tmp/containerbase" ]]; then
  # initialize all prepared tools
  containerbase-cli init tool all
fi

if [[ -x "/opt/containerbase/bin/renovate-config-validator" ]]; then
  # prefer a validator installed via `postUpgradeTasks.installTools`
  export NODE_OPTIONS="--use-openssl-ca${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
  exec /opt/containerbase/bin/renovate-config-validator "$@"
fi

exec /usr/local/renovate/node --use-openssl-ca /usr/local/renovate/dist/config-validator.js "$@"
